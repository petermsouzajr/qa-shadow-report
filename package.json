{
  "name": "qa-shadow-report",
  "version": "2.1.8",
  "bin": {
    "qa-shadow-report": "./cli.js",
    "qasr": "./cli.js",
    "qasr-setup": "./scripts/postInstall.js"
  },
  "description": "npm package that prints formatted test reports into a google sheet or csv file",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "cli.js",
    "constants.js",
    "src/**/*.js",
    "!src/**/*.test.js",
    "scripts/postInstall.js",
    "scripts/configuredStatus.js",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:sanity": "node --experimental-vm-modules node_modules/.bin/jest --testNamePattern='\\[sanity\\]'",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "docs": "jsdoc -c jsdoc.json",
    "prepublishOnly": "npm test && npm run lint"
  },
  "repository": "git+ssh://git@github.com/petermsouzajr/qa-shadow-report.git",
  "keywords": [
    "google",
    "sheets",
    "cypress",
    "playwright",
    "report",
    "testrail",
    "test",
    "csv"
  ],
  "author": "Peter Michael Souza Junior",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/petermsouzajr/qa-shadow-report/issues"
  },
  "homepage": "https://github.com/petermsouzajr/qa-shadow-report#readme",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@faker-js/faker": "^10.5.0",
    "@types/jest": "^29.5.12",
    "babel-jest": "^30.4.1",
    "docdash": "^2.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^50.6.6",
    "eslint-plugin-n": "^16.0.2",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.3"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "brace-expansion": "^1.1.16",
    "minimatch": "^3.1.3",
    "braces": "^3.0.3",
    "picomatch": "^2.3.2",
    "linkify-it": "^5.0.2",
    "qs": "^6.16.0",
    "@faker-js/faker": "^10.5.0",
    "markdown-it": "^14.2.0"
  }
}
