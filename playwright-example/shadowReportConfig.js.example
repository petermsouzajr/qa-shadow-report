// shadowReportConfig.js.example
// Copy this file to shadowReportConfig.js and fill in your Google Sheets credentials

module.exports = {
  // Team identifiers that appear in test annotations like [billing] or [unicorns]
  teamNames: ['billing', 'platform', 'unicorns', 'robots'],

  // Test types organized by folder structure (e.g., tests/api/ or tests/ui/)
  testTypes: [
    'api',
    'ui',
    'unit',
    'integration',
    'endToEnd',
    'performance',
    'security',
    'database',
    'accessibility',
    'mobile',
  ],

  // Test categories that appear in test annotations like [smoke] or [regression]
  testCategories: [
    'smoke',
    'regression',
    'sanity',
    'exploratory',
    'functional',
    'load',
    'stress',
    'usability',
    'compatibility',
    'alpha',
    'beta',
    'performance',
    'accessibility',
  ],

  // Your Google Spreadsheet URL
  // Example: 'https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit'
  googleSpreadsheetUrl: 'YOUR_GOOGLE_SPREADSHEET_URL_HERE',

  // Path to your Google service account credentials JSON file
  // See: https://theoephraim.github.io/node-google-spreadsheet/#/guides/authentication
  googleKeyFilePath: './googleCredentials.json',

  // Path to the test results JSON file (generated by Playwright's json reporter)
  testData: './test-results/output.json',

  // Directory where CSV reports will be saved (when using --csv flag)
  csvDownloadsPath: './downloads',

  // Uncomment to enable weekly summary (starting on specified day)
  // Options: 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'
  // weeklySummaryStartDay: 'Monday',
};
